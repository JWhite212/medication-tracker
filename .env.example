# MedTracker environment variables
# Copy this file to .env and fill in the values you need.
# Anything marked "optional" can be left blank — the related feature
# will be disabled at runtime.

# === Required ===

# Postgres connection string (Neon, Supabase, RDS, local docker, etc).
# Use ?sslmode=require for managed providers.
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# === OAuth (optional) ===
# Enables "Continue with Google" / "Continue with GitHub" on the login page.
# Leave blank to hide those buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Email (optional) ===
# Required for password reset, email verification, and email reminders.
# Sign up at https://resend.com and create an API key.
RESEND_API_KEY=

# Sender address for outgoing email. Format: "Display Name <addr@domain.tld>".
# Defaults to a placeholder — set this to a verified Resend domain in production.
EMAIL_FROM=MedTracker <noreply@example.com>

# Public base URL of the deployed app, used to build links inside emails
# (password reset, email verification). REQUIRED in any non-dev build —
# server boot will throw if it is missing or not https. In dev it falls
# back to http://localhost:5173. Email links are NEVER derived from the
# inbound request — that prevented a host-header injection takeover.
# Example: https://medication-tracker.jamiewhite.site
PUBLIC_BASE_URL=

# === Build (production deploys only) ===
# When set to "true", the Vercel build runs `drizzle-kit push` against
# DATABASE_URL before bundling, so deploys can never ship code that
# references a column the database doesn't have. Leave unset on local
# and preview environments — those should not touch the prod schema.
# See scripts/vercel-build.mjs.
MIGRATE_ON_BUILD=

# === Cron (optional) ===
# Shared secret for the /api/cron/reminders endpoint. Vercel Cron sends
# this in the Authorization header. Generate any random 32+ char string.
CRON_SECRET=

# === Monitoring (optional, production only) ===
# Dead-man switch URL, pinged at the END of a successful reminder tick.
# The point is to detect *absence*: a cron that silently stops running
# produces no error to alert on, which is how CRON_SECRET being unset
# went unnoticed for four months. The receiving service alerts when an
# expected ping does not arrive.
#
# Provider-agnostic — Healthchecks.io, Better Stack, Cronitor and Uptime
# Kuma all expose this as "GET an opaque URL", so switching provider is
# an env var change. Must be https. The URL is itself the credential,
# so treat it as a secret.
#
# Leave UNSET everywhere except production. A preview deployment or a
# local run pinging production's switch would keep it green and mask a
# real outage. Unset is a silent no-op.
# Example: https://hc-ping.com/<uuid>
HEARTBEAT_URL=

# === Encryption (recommended in production) ===
# Used to encrypt TOTP secrets at rest (and any future at-rest secrets).
# Must remain stable across deploys — rotating it invalidates 2FA for
# every user. Generate once with: openssl rand -base64 48
ENCRYPTION_KEY=

# === Web Push (optional) ===
# Generate with: npx web-push generate-vapid-keys
# Required for browser push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact email surfaced to push services (RFC 8292).
VAPID_EMAIL=

# === Feature flags (optional) ===
# Drug-interaction checking via OpenFDA. Marked experimental in the UI;
# leave unset to disable the feature entirely.
INTERACTIONS_ENABLED=false

# === Sign in with Apple (optional; required for the macOS app's SIWA) ===
APPLE_CLIENT_ID=          # the app's Services ID / bundle id used as the token audience
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=        # PKCS8 .p8 contents (only needed for the web redirect flow)
